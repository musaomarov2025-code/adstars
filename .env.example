# Токен управляющего бота (от @BotFather)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram ID (для уведомлений от бота)
OWNER_ID=123456789

# API_ID и API_HASH с my.telegram.org
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# URL Mini App (для кнопки в боте, HTTPS обязателен)
WEBAPP_URL=https://your-domain.com

# Путь к БД и сессиям
DB_PATH=data.db
SESSION_PATH=sessions/user
